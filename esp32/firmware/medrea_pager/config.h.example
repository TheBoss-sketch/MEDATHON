#ifndef MEDREA_CONFIG_H
#define MEDREA_CONFIG_H

// ==========================================
// MEDREA Pager Configuration Template
// Copy this file to "config.h" and fill in your local values.
// DO NOT commit config.h to version control.
// ==========================================

// Wi-Fi Credentials
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// MEDREA Backend WebSocket Host & Port
// Note: ESP32 cannot use 'localhost'. Use your computer's local LAN IP (e.g., 192.168.1.50)
#define BACKEND_HOST  "192.168.1.100"
#define BACKEND_PORT  8000
#define WS_PATH       "/ws/pager"

#endif // MEDREA_CONFIG_H
